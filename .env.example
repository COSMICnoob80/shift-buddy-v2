# ─── Application ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://shiftbuddy:shiftbuddy@localhost:5432/shiftbuddy

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth (JWT) ───────────────────────────────────────────────
# HS256 only. DO NOT commit a real secret.
JWT_SECRET=change-me-in-real-env-this-is-only-a-placeholder
JWT_ALGORITHM=HS256
JWT_EXPIRES_MIN=15

# ─── Clinical Config (Principle XI) ─────────────────────────
# Schema-validated via api/app/core/clinical_config.py.
# P0 vitals thresholds (placeholder — no protocol logic in P0).
CLINICAL_HR_MIN=60
CLINICAL_HR_MAX=100
CLINICAL_SBP_MIN=90

# P1a lab critical thresholds — 10 vars for 7 test types.
# Hospitals tune these by changing env, not patching code (Principle XI).
CLINICAL_LAB_K_CRITICAL_HIGH=6.0
CLINICAL_LAB_K_CRITICAL_LOW=2.5
CLINICAL_LAB_NA_CRITICAL_HIGH=155.0
CLINICAL_LAB_NA_CRITICAL_LOW=125.0
CLINICAL_LAB_HB_CRITICAL_LOW=7.0
CLINICAL_LAB_PLT_CRITICAL_LOW=50.0
CLINICAL_LAB_INR_CRITICAL_HIGH=3.0
CLINICAL_LAB_BS_CRITICAL_HIGH=400.0
CLINICAL_LAB_BS_CRITICAL_LOW=54.0
CLINICAL_LAB_LACTATE_CRITICAL_HIGH=4.0
