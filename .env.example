# ─── Application ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://shiftbuddy:shiftbuddy@localhost:5432/shiftbuddy

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth (JWT) ───────────────────────────────────────────────
# HS256 only. DO NOT commit a real secret.
JWT_SECRET=change-me-in-real-env-this-is-only-a-placeholder
JWT_ALGORITHM=HS256
JWT_EXPIRES_MIN=15

# ─── Clinical Config (Principle XI — loader only in P0) ───────
# Schema-validated via api/app/core/clinical_config.py.
# Values below are placeholders; no protocol logic consumes them in P0.
CLINICAL_HR_MIN=60
CLINICAL_HR_MAX=100
CLINICAL_SBP_MIN=90
